{
  "name": "selaras-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Selaras — Privacy-by-design employee health, posture, and focus analytics",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "dev:dashboard": "pnpm --filter @selaras/dashboard dev",
    "dev:extension": "pnpm --filter @selaras/extension dev",
    "test": "pnpm --filter \"./packages/*\" run test",
    "test:coverage": "pnpm --filter \"./packages/*\" run test:coverage",
    "lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
